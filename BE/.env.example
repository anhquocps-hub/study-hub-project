DATABASE_URL="postgresql://studyhub:studyhub_dev@localhost:5432/studyhub?schema=public"
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET="studyhub_access_secret_super_secure_key_123!"
JWT_REFRESH_SECRET="studyhub_refresh_secret_super_secure_key_456!"
