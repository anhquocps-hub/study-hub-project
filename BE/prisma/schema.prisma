generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model University {
  id     String  @id
  name   String
  majors Major[]
  users  User[]

  @@map("universities")
}

model Major {
  id           String     @id
  name         String
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  profiles     Profile[]

  @@index([universityId])
  @@map("majors")
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String               @map("password_hash")
  fullName         String               @map("full_name")
  studentId        String?              @map("student_id")
  universityId     String?              @map("university_id")
  university       University?          @relation(fields: [universityId], references: [id], onDelete: SetNull)
  role             Role                 @default(USER)
  status           UserStatus           @default(ACTIVE)
  profileCompleted Boolean              @default(false) @map("profile_completed")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  profile          Profile?
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]

  @@index([universityId])
  @@map("users")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl    String?  @map("avatar_url")
  majorId      String?  @map("major_id")
  major        Major?   @relation(fields: [majorId], references: [id], onDelete: SetNull)
  cohort       String?  @map("cohort")
  bio          String   @default("")
  skills       Json     @default("[]")
  interests    Json     @default("[]")
  githubUrl    String?  @map("github_url")
  linkedinUrl  String?  @map("linkedin_url")
  portfolioUrl String?  @map("portfolio_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([majorId])
  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
