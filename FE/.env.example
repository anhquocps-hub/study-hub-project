VITE_API_BASE_URL=http://localhost:3000
# true = dùng dữ liệu giả trong features/*/api/*.mock.ts; false = gọi API thật của BE
VITE_USE_MOCK_API=true
# Các feature luôn gọi BE thật dù VITE_USE_MOCK_API=true, cách nhau bởi dấu phẩy.
# Feature có BE: auth, admin-users, profiles, academic. Để trống = theo VITE_USE_MOCK_API.
VITE_REAL_API_FEATURES=
